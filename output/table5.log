. use "$root/output/al_clean.dta", clear

. keep if grade == 4
(2,019 observations deleted)

. isid schlcode classid

. assert !missing(c_size, classize, schlcode, fsc)

. assert abs(fsc - c_size/(floor((c_size-1)/40)+1)) < 0.00001

. assert disc5 == (inrange(c_size,36,45) | inrange(c_size,76,85) | inrange(c_si
> ze,116,125))

. 
. gen double c_size2 = c_size^2/100

. * Continuous piecewise trend: slopes match fsc between cutoffs.
. * Only defined through 160; larger cohorts leave this specification.
. gen double trend = c_size if c_size <= 40
(1,755 missing values generated)

. replace trend = 20 + c_size/2 if inrange(c_size,41,80)
(868 real changes made)

. replace trend = 100/3 + c_size/3 if inrange(c_size,81,120)
(638 real changes made)

. replace trend = 130/3 + c_size/4 if inrange(c_size,121,160)
(201 real changes made)

. gen byte full = 1

. 
. local ctrl1 tipuach

. local ctrl2 tipuach c_size

. local ctrl3 tipuach c_size c_size2

. local ctrl4 trend

. local ctrl5 tipuach

. local ctrl6 tipuach c_size

. * Specification 4 intentionally omits PD, as in the published table.
. local sample1 full

. local sample2 full

. local sample3 full

. local sample4 full

. local sample5 disc5

. local sample6 disc5

. 
. tempname results

. tempfile records

. postfile `results' int order str32 row byte column double value using "`recor
> ds'", replace
(note: file C:\Users\tyan0083\AppData\Local\Temp\ST_51d0_000001.tmp not found)

. local column = 0

. local models

. foreach y in avgverb avgmath {
  2.     forvalues s = 1/6 {
  3.         local ++column
  4.         display "Table V column `column': `y', specification `s'"
  5.         ivregress 2sls `y' `ctrl`s'' (classize = fsc) ///
>             if `sample`s'' == 1, vce(cluster schlcode)
  6.         estimates store T5_`column'
  7.         local models `models' T5_`column'
  8.         record_table_result `results' `column' `y' "classize tipuach c_siz
> e c_size2 trend"
  9.         gen byte estimation_sample = e(sample)
 10. 
.         * First stage on exactly the same observations and controls as 2SLS.
.         * This clustered F tests the excluded instrument, not all regressors.
.         regress classize fsc `ctrl`s'' if estimation_sample, vce(cluster schl
> code)
 11.         test fsc
 12.         post `results' (94) ("first_stage_F") (`column') (r(F))
 13.         post `results' (95) ("first_stage_p") (`column') (r(p))
 14.         drop estimation_sample
 15.     }
 16. }
