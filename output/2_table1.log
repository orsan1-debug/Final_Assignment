. *--- panel B: +/-5 discontinuity sample, mean and s.d. only, as printed (p 539)
. file write t1 "\midrule" _n

. file write t1 "\multicolumn{8}{l}{B. +/-5 discontinuity sample (enrollment 36--45, 76--85, 116--125)} \\" _n   // 125 not the header's 124 (1_clean.do section 5)

. foreach g in 5 4 {
  2.     count if grade == `g' & disc5 == 1
  3.     local ncl = r(N)
  4.     count if grade == `g' & disc5 == 1 & sch_first == 1
  5.     local nsch = r(N)
  6.     display _n "Panel B, grade `g': `ncl' classes, `nsch' schools"   // 471 and 224 grade 5, 415 and 195 grade 4, matches paper (p 539)
  7.     file write t1 "\multicolumn{8}{l}{`g'th grade (`ncl' classes, `nsch' schools)} \\" _n
  8.     foreach v in `vars' {
  9.         quietly summarize `v' if grade == `g' & disc5 == 1
 10.         local m  : display %6.1f r(mean)
 11.         local sd : display %6.1f r(sd)
 12.         display "`lab_`v'': mean `m'  sd `sd'"       // grade 5 class size 30.8 (7.4), enrollment 76.4, average verbal 74.5, average math 67.0, then grade 4 31.1 (7.2), 78.5, 72.5, 68.7, matches pa
> per (p 539)
 13.         file write t1 "`lab_`v'' & `=trim("`m'")' & `=trim("`sd'")' & & & & & \\" _n
 14.     }
 15. }
