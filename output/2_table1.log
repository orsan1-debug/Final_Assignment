. use "$root/output/al_clean.dta", clear

. 
. /*=========================================================================*/
. *---rows of the table, in the paper's order, and their labels (Table I notes)---*
. /*=========================================================================*/
. local vars classize c_size tipuach verbsize mathsize avgverb avgmath

. local lab_classize "Class size"

. local lab_c_size   "Enrollment"

. local lab_tipuach  "Percent disadvantaged"

. local lab_verbsize "Reading size"

. local lab_mathsize "Math size"

. local lab_avgverb  "Average verbal"

. local lab_avgmath  "Average math"

. 
. /*=========================================================================*/
. *---write the table---*
. /*=========================================================================*/
. file open t1 using "$root/output/table1.tex", write replace
(file C:/Users/otisr/Documents/ECX5479/Final_Assignment/output/table1.tex not found)

. file write t1 "\begin{tabular}{lccccccc}" _n

. file write t1 "\toprule" _n

. file write t1 " & & & \multicolumn{5}{c}{Quantiles} \\" _n

. file write t1 "Variable & Mean & S.D. & 0.10 & 0.25 & 0.50 & 0.75 & 0.90 \\" _n

. file write t1 "\midrule" _n

. 
. *---Panel A: full sample---*
. file write t1 "\multicolumn{8}{l}{A. Full sample} \\" _n

. foreach g in 5 4 {                                   // grade 5 first, as in the paper
  2.     count if grade == `g'
  3.     local ncl = r(N)                                 // classes
  4.     count if grade == `g' & sch_first == 1
  5.     local nsch = r(N)                                // schools (tag built in 1_clean.do)
  6.     display _n "Panel A, grade `g': `ncl' classes, `nsch' schools"
  7.     file write t1 "\multicolumn{8}{l}{`g'th grade (`ncl' classes, `nsch' schools, tested in 1991)} \\" _n
  8.     foreach v in `vars' {
  9.         quietly summarize `v' if grade == `g', detail
 10.         local m   : display %6.1f r(mean)
 11.         local sd  : display %6.1f r(sd)
 12.         local p10 : display %6.1f r(p10)
 13.         local p25 : display %6.1f r(p25)
 14.         local p50 : display %6.1f r(p50)
 15.         local p75 : display %6.1f r(p75)
 16.         local p90 : display %6.1f r(p90)
 17.         display "`lab_`v'': mean `m'  sd `sd'  p10 `p10'  p25 `p25'  p50 `p50'  p75 `p75'  p90 `p90'"
 18.         file write t1 "`lab_`v'' & `=trim("`m'")' & `=trim("`sd'")' & `=trim("`p10'")' & `=trim("`p25'")' & `=trim("`p50'")' & `=trim("`p75'")' & `=trim("`p90'")' \\" _n
 19.     }
 20. }
