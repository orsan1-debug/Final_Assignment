. *---Panel B: +/-5 discontinuity sample (enrollment 36-45, 76-85, 116-125)---*
. file write t1 "\midrule" _n

. file write t1 "\multicolumn{8}{l}{B. +/-5 discontinuity sample (enrollment 36--45, 76--85, 116--125)} \\" _n

. foreach g in 5 4 {
  2.     count if grade == `g' & disc5 == 1
  3.     local ncl = r(N)
  4.     count if grade == `g' & disc5 == 1 & sch_first == 1
  5.     local nsch = r(N)
  6.     display _n "Panel B, grade `g': `ncl' classes, `nsch' schools"
  7.     file write t1 "\multicolumn{8}{l}{`g'th grade (`ncl' classes, `nsch' schools)} \\" _n
  8.     foreach v in `vars' {
  9.         quietly summarize `v' if grade == `g' & disc5 == 1
 10.         local m  : display %6.1f r(mean)
 11.         local sd : display %6.1f r(sd)
 12.         display "`lab_`v'': mean `m'  sd `sd'"
 13.         file write t1 "`lab_`v'' & `=trim("`m'")' & `=trim("`sd'")' & & & & & \\" _n
 14.     }
