. 
. * seg3 is omitted because a constant plus all three segments is collinear.
. local ctrl1 tipuach seg1 seg2

. local ctrl2 tipuach seg1 seg2

. local ctrl3 seg1 seg2

. local sample1 disc5

. local sample2 disc3

. local sample3 disc3

. 
. tempname results

. tempfile records

. postfile `results' int order str32 row byte column double value using "`recor
> ds'", replace
(note: file C:\Users\tyan0083\AppData\Local\Temp\ST_51d0_000001.tmp not found)

. local column = 0

. local models

. foreach g in 5 4 {
  2.     foreach y in avgverb avgmath {
  3.         forvalues s = 1/3 {
  4.             local ++column
  5.             display "Table VI column `column': grade `g', `y', specificati
> on `s'"
  6.             ivregress 2sls `y' `ctrl`s'' (classize = z1 z2 z3) ///
>                 if grade == `g' & `sample`s'' == 1, vce(cluster schlcode)
  7.             estimates store T6_`column'
  8.             local models `models' T6_`column'
  9.             record_table_result `results' `column' `y' "classize tipuach s
> eg1 seg2"
 10.             gen byte estimation_sample = e(sample)
 11.             regress classize z1 z2 z3 `ctrl`s'' if estimation_sample, vce(
> cluster schlcode)
 12.             test z1 z2 z3
 13.             post `results' (94) ("first_stage_F") (`column') (r(F))
 14.             post `results' (95) ("first_stage_p") (`column') (r(p))
 15.             drop estimation_sample
 16.         }
 17.     }
 18. }
